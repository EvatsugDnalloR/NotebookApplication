<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.fxmisc.richtext.*?>

<BorderPane prefHeight="545.0" prefWidth="709.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="notebookapplication.gui.Controller">
   <top>
      <HBox fx:id="groupBar" prefHeight="24.0" prefWidth="513.0" BorderPane.alignment="CENTER">
         <children>
            <ToggleButton fx:id="defaultGroup" mnemonicParsing="false" prefHeight="27.0" prefWidth="70.0" text="Group 1" />
            <Button fx:id="addGroup" mnemonicParsing="false" onAction="#addNewGroup" prefHeight="23.0" prefWidth="37.0" text="+" />
         </children>
      </HBox>
   </top>
   <right>
      <VBox fx:id="pageBar" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <ToggleButton fx:id="defaultPage" mnemonicParsing="false" prefHeight="21.0" prefWidth="103.0" text="Page 1" />
            <Button fx:id="addPage" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#addNewPage" prefHeight="21.0" prefWidth="103.0" text="+" />
         </children></VBox>
   </right>
   <center>
      <InlineCssTextArea fx:id="textArea" prefHeight="248.0" prefWidth="413.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
